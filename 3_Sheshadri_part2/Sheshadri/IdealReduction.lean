import Mathlib.Data.Matrix.Mul
import Mathlib.RingTheory.Ideal.Span

/-!
# Scheme-theoretic kernel elimination (Section 4, Step 5)

These are ideal equalities over an arbitrary commutative ring.  In particular,
they preserve nilpotents and are stronger than assertions about point sets.

For the ordinary model, after recentering the kernel coordinates, the actual
equations are `(p B, p dot c + g, M z + g lambda)`.  Invertibility of `B` and
`M` reduces their ideal to `(p, g, z)`.  Only the one-sided inverse identities
used in the proof are assumed.  No geometric assertions are axiomatized here.
-/

namespace Sheshadri

open Matrix
open scoped BigOperators

variable {R : Type*} [CommRing R]
variable {ι κ : Type*} [Fintype ι] [Fintype κ]

/-- The ideal generated by a family of scalar equations. -/
def equationIdeal {α : Type*} (f : α → R) : Ideal R :=
  Ideal.span (Set.range f)

theorem equationIdeal_le_iff {α : Type*} (f : α → R) (J : Ideal R) :
    equationIdeal f ≤ J ↔ ∀ i, f i ∈ J := by
  constructor
  · intro h i
    exact h (Ideal.subset_span ⟨i, rfl⟩)
  · intro h
    apply Ideal.span_le.mpr
    rintro x ⟨i, rfl⟩
    exact h i

/-- Two families of equations with one scalar equation between them. -/
def tripleIdeal {α β : Type*} (f : α → R) (a : R) (h : β → R) : Ideal R :=
  equationIdeal f ⊔ Ideal.span {a} ⊔ equationIdeal h

theorem tripleIdeal_le_iff {α β : Type*} (f : α → R) (a : R)
    (h : β → R) (J : Ideal R) :
    tripleIdeal f a h ≤ J ↔
      ((∀ i, f i ∈ J) ∧ a ∈ J) ∧ (∀ j, h j ∈ J) := by
  simp only [tripleIdeal, sup_le_iff, equationIdeal_le_iff,
    Ideal.span_le, Set.singleton_subset_iff]
  rfl

omit [Fintype κ] in
theorem vecMul_mem_of_mem (J : Ideal R) (p : ι → R) (B : Matrix ι κ R)
    (hp : ∀ i, p i ∈ J) (j : κ) : (p ᵥ* B) j ∈ J := by
  change (∑ i, p i * B i j) ∈ J
  exact J.sum_mem (fun i _ => J.mul_mem_right _ (hp i))

omit [Fintype κ] in
theorem mulVec_mem_of_mem (J : Ideal R) (M : Matrix κ ι R) (z : ι → R)
    (hz : ∀ i, z i ∈ J) (j : κ) : (M *ᵥ z) j ∈ J := by
  change (∑ i, M j i * z i) ∈ J
  exact J.sum_mem (fun i _ => J.mul_mem_left _ (hz i))

theorem dotProduct_mem_of_mem (J : Ideal R) (p c : ι → R)
    (hp : ∀ i, p i ∈ J) : (p ⬝ᵥ c) ∈ J := by
  change (∑ i, p i * c i) ∈ J
  exact J.sum_mem (fun i _ => J.mul_mem_right _ (hp i))

/-- The ordinary-model ideal identity, equation (7) of the paper.

`B * Binv = 1` recovers the row coordinates `p` from `p B`.
`Minv * M = 1` recovers the column coordinates `z` from `M z`.
The latter is precisely the role of the generic reduction matrix Lambda.
-/
theorem ordinary_kernel_ideal
    [DecidableEq ι] [DecidableEq κ]
    (B Binv : Matrix ι ι R) (M Minv : Matrix κ κ R)
    (p c : ι → R) (z lam : κ → R) (g : R)
    (hB : B * Binv = 1) (hM : Minv * M = 1) :
    tripleIdeal (p ᵥ* B) (p ⬝ᵥ c + g)
      (fun i => (M *ᵥ z) i + g * lam i) =
    tripleIdeal p g z := by
  apply le_antisymm
  · apply (tripleIdeal_le_iff _ _ _ _).mpr
    have h := (tripleIdeal_le_iff p g z (tripleIdeal p g z)).mp le_rfl
    refine ⟨⟨?_, ?_⟩, ?_⟩
    · exact vecMul_mem_of_mem _ p B h.1.1
    · exact (tripleIdeal p g z).add_mem
        (dotProduct_mem_of_mem _ p c h.1.1) h.1.2
    · intro i
      exact (tripleIdeal p g z).add_mem
        (mulVec_mem_of_mem _ M z h.2 i)
        ((tripleIdeal p g z).mul_mem_right _ h.1.2)
  · let J := tripleIdeal (p ᵥ* B) (p ⬝ᵥ c + g)
        (fun i => (M *ᵥ z) i + g * lam i)
    have h := (tripleIdeal_le_iff (p ᵥ* B) (p ⬝ᵥ c + g)
      (fun i => (M *ᵥ z) i + g * lam i) J).mp le_rfl
    have hp : ∀ i, p i ∈ J := by
      intro i
      have ht := vecMul_mem_of_mem J (p ᵥ* B) Binv h.1.1 i
      simpa only [Matrix.vecMul_vecMul, hB, Matrix.vecMul_one] using ht
    have hg : g ∈ J := by
      have ht := J.sub_mem h.1.2 (dotProduct_mem_of_mem J p c hp)
      simpa only [add_sub_cancel_left] using ht
    have hMz : ∀ i, (M *ᵥ z) i ∈ J := by
      intro i
      have ht := J.sub_mem (h.2 i) (J.mul_mem_right (lam i) hg)
      simpa only [add_sub_cancel_right] using ht
    have hz : ∀ i, z i ∈ J := by
      intro i
      have ht := mulVec_mem_of_mem J Minv (M *ᵥ z) hMz i
      simpa only [Matrix.mulVec_mulVec, hM, Matrix.one_mulVec] using ht
    exact (tripleIdeal_le_iff p g z J).mpr ⟨⟨hp, hg⟩, hz⟩

/-- The symmetric-model ideal identity: the full kernel equations reduce to
the recentered kernel coordinates and the Schur complement. -/
theorem symmetric_kernel_ideal [DecidableEq ι]
    (B Binv : Matrix ι ι R) (z c : ι → R) (g : R)
    (hB : Binv * B = 1) :
    equationIdeal (B *ᵥ z) ⊔ Ideal.span {c ⬝ᵥ z + g} =
    equationIdeal z ⊔ Ideal.span {g} := by
  apply le_antisymm
  · apply sup_le
    · apply (equationIdeal_le_iff _ _).mpr
      intro i
      apply mulVec_mem_of_mem
      intro j
      exact Ideal.mem_sup_left (Ideal.subset_span ⟨j, rfl⟩)
    · apply Ideal.span_le.mpr
      intro a ha
      obtain rfl := Set.mem_singleton_iff.mp ha
      apply (equationIdeal z ⊔ Ideal.span {g}).add_mem
      · change (∑ i, c i * z i) ∈ _
        apply (equationIdeal z ⊔ Ideal.span {g}).sum_mem
        intro i _
        apply (equationIdeal z ⊔ Ideal.span {g}).mul_mem_left
        exact Ideal.mem_sup_left (Ideal.subset_span ⟨i, rfl⟩)
      · exact Ideal.mem_sup_right (Ideal.subset_span (Set.mem_singleton g))
  · let J := equationIdeal (B *ᵥ z) ⊔ Ideal.span {c ⬝ᵥ z + g}
    have hBz : ∀ i, (B *ᵥ z) i ∈ J := by
      intro i
      exact Ideal.mem_sup_left (Ideal.subset_span ⟨i, rfl⟩)
    have hz : ∀ i, z i ∈ J := by
      intro i
      have ht := mulVec_mem_of_mem J Binv (B *ᵥ z) hBz i
      simpa only [Matrix.mulVec_mulVec, hB, Matrix.one_mulVec] using ht
    have hcz : c ⬝ᵥ z ∈ J := by
      change (∑ i, c i * z i) ∈ J
      exact J.sum_mem (fun i _ => J.mul_mem_left _ (hz i))
    have hg : g ∈ J := by
      have hlast : c ⬝ᵥ z + g ∈ J :=
        Ideal.mem_sup_right (Ideal.subset_span (Set.mem_singleton _))
      have ht := J.sub_mem hlast hcz
      simpa only [add_sub_cancel_left] using ht
    apply sup_le
    · exact (equationIdeal_le_iff z J).mpr hz
    · exact Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hg)

end Sheshadri
