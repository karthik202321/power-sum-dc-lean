import Mathlib.Algebra.MvPolynomial.Funext
import Mathlib.Data.Matrix.Mul
import Mathlib.LinearAlgebra.Pi
import Mathlib.LinearAlgebra.Matrix.ToLin
import Mathlib.Tactic.FieldSimp
import Mathlib.Tactic.Ring

/-!
# One reduction map for finitely many image hyperplanes

A nonzero product of linear forms cannot vanish everywhere over an infinite
field. We use this to choose a single vector outside finitely many prescribed
hyperplanes, also avoiding the first coordinate hyperplane. An explicit
surjective map with that vector as its kernel then gives the simultaneous
reduction required by the ordinary determinantal incidence.
-/

namespace Sheshadri.GenericReduction

open Matrix MvPolynomial
open scoped BigOperators

noncomputable section
variable {K : Type*} [Field K] [Infinite K]
variable {J : Type*} [Fintype J] {k : ℕ}

def linearPolynomial (u : Fin (k + 1) → K) : MvPolynomial (Fin (k + 1)) K :=
  ∑ i, C (u i) * X i

omit [Infinite K] in
@[simp] theorem eval_linearPolynomial (u w : Fin (k + 1) → K) :
    eval w (linearPolynomial u) = u ⬝ᵥ w := by
  simp [linearPolynomial, dotProduct]

omit [Infinite K] in
theorem linearPolynomial_ne_zero {u : Fin (k + 1) → K} (hu : u ≠ 0) :
    linearPolynomial u ≠ 0 := by
  classical
  obtain ⟨i, hi⟩ : ∃ i, u i ≠ 0 := by
    by_contra h
    apply hu
    ext i
    simpa using not_exists.mp h i
  intro hp
  have h := congrArg (eval (Pi.single i (1 : K))) hp
  simp [dotProduct, Pi.single_apply] at h
  exact hi h

/-- Simultaneous avoidance of finitely many proper linear hyperplanes. -/
theorem exists_common_vector (u : J → Fin (k + 1) → K) (hu : ∀ j, u j ≠ 0) :
    ∃ w : Fin (k + 1) → K, w 0 ≠ 0 ∧ ∀ j, u j ⬝ᵥ w ≠ 0 := by
  classical
  let P : MvPolynomial (Fin (k + 1)) K := X 0 * ∏ j, linearPolynomial (u j)
  have hP : P ≠ 0 := mul_ne_zero (X_ne_zero (0 : Fin (k + 1)))
    (Finset.prod_ne_zero_iff.mpr fun j _ => linearPolynomial_ne_zero (hu j))
  have hex : ∃ w, eval w P ≠ 0 := by
    by_contra h
    apply hP
    apply MvPolynomial.funext
    intro w
    simpa using not_exists.mp h w
  obtain ⟨w, hw⟩ := hex
  have hw' : w 0 * ∏ j, u j ⬝ᵥ w ≠ 0 := by simpa [P] using hw
  exact ⟨w, (mul_ne_zero_iff.mp hw').1,
    fun j => (Finset.prod_ne_zero_iff.mp (mul_ne_zero_iff.mp hw').2) j (Finset.mem_univ j)⟩

/-- A concrete map onto k coordinates with kernel generated by w. -/
def reduction (w : Fin (k + 1) → K) : (Fin (k + 1) → K) →ₗ[K] (Fin k → K) where
  toFun z i := z i.succ - (w i.succ / w 0) * z 0
  map_add' a b := by ext i; simp; ring
  map_smul' c a := by ext i; simp; ring

omit [Infinite K] in
@[simp] theorem reduction_apply (w z : Fin (k + 1) → K) (i : Fin k) :
    reduction w z i = z i.succ - (w i.succ / w 0) * z 0 := rfl

omit [Infinite K] in
theorem reduction_surjective (w : Fin (k + 1) → K) :
    Function.Surjective (reduction w) := by
  intro z
  refine ⟨Fin.cons 0 z, ?_⟩
  ext i
  simp

omit [Infinite K] in
theorem reduction_eq_zero_iff {w z : Fin (k + 1) → K} (hw : w 0 ≠ 0) :
    reduction w z = 0 ↔ ∃ c : K, z = c • w := by
  constructor
  · intro h
    refine ⟨z 0 / w 0, ?_⟩
    ext i
    refine Fin.cases ?_ (fun j => ?_) i
    · simp [div_mul_cancel₀ _ hw]
    · have hj := congrFun h j
      simp only [reduction_apply, Pi.zero_apply, sub_eq_zero] at hj
      simp only [Pi.smul_apply, smul_eq_mul]
      rw [hj]
      ring
  · rintro ⟨c, rfl⟩
    ext i
    simp only [reduction_apply, Pi.smul_apply, smul_eq_mul, Pi.zero_apply]
    field_simp
    ring

omit [Infinite K] in
/-- The reduced kernel is trivial on every hyperplane avoided by w. -/
theorem reduction_injective_on_annihilator {w u z : Fin (k + 1) → K}
    (hw : w 0 ≠ 0) (hu : u ⬝ᵥ w ≠ 0)
    (hz : u ⬝ᵥ z = 0) (hr : reduction w z = 0) : z = 0 := by
  obtain ⟨c, rfl⟩ := (reduction_eq_zero_iff hw).mp hr
  rw [dotProduct_smul, smul_eq_mul] at hz
  have hc : c = 0 := (mul_eq_zero.mp hz).resolve_right hu
  simp [hc]

/-- A single surjective (m-1)-row reduction works for a finite matrix family.
The supplied nonzero left annihilator of each matrix identifies an image
hyperplane to avoid. No rank or genericity assumption is hidden in the conclusion. -/
theorem exists_simultaneous_reduction
    (A : J → Matrix (Fin (k + 1)) (Fin (k + 1)) K)
    (u : J → Fin (k + 1) → K)
    (hu : ∀ j, u j ≠ 0) (hleft : ∀ j, u j ᵥ* A j = 0) :
    ∃ Λ : (Fin (k + 1) → K) →ₗ[K] (Fin k → K),
      Function.Surjective Λ ∧
      ∀ j v, Λ (A j *ᵥ v) = 0 → A j *ᵥ v = 0 := by
  obtain ⟨w, hw, havoid⟩ := exists_common_vector u hu
  refine ⟨reduction w, reduction_surjective w, ?_⟩
  intro j v h
  apply reduction_injective_on_annihilator hw (havoid j) _ h
  rw [dotProduct_mulVec, hleft j, zero_dotProduct]

/-- Matrix-valued formulation of simultaneous reduction, in precisely the
kernel/image form used by `ReductionMap.reduced_columns_isUnit`. -/
theorem exists_simultaneous_reduction_matrix
    (A : J → Matrix (Fin (k + 1)) (Fin (k + 1)) K)
    (u : J → Fin (k + 1) → K)
    (hu : ∀ j, u j ≠ 0) (hleft : ∀ j, u j ᵥ* A j = 0) :
    ∃ L : Matrix (Fin k) (Fin (k + 1)) K,
      Function.Surjective L.mulVecLin ∧
      ∀ j, LinearMap.ker L.mulVecLin ⊓ LinearMap.range (A j).mulVecLin = ⊥ := by
  obtain ⟨Λ, hsurj, hΛ⟩ := exists_simultaneous_reduction A u hu hleft
  refine ⟨LinearMap.toMatrix' Λ, ?_, ?_⟩
  · simpa only [← Matrix.toLin'_apply', Matrix.toLin'_toMatrix'] using hsurj
  · intro j
    apply le_antisymm _ bot_le
    rintro z ⟨hzker, v, rfl⟩
    apply hΛ j v
    simpa only [LinearMap.mem_ker, ← Matrix.toLin'_apply', Matrix.toLin'_toMatrix',
      Matrix.mulVecLin_apply] using hzker

/-- Strong form: the chosen matrix has trivial kernel on each complete
annihilator hyperplane, not merely on each matrix image. -/
theorem exists_reduction_on_hyperplanes
    (u : J → Fin (k + 1) → K) (hu : ∀ j, u j ≠ 0) :
    ∃ L : Matrix (Fin k) (Fin (k + 1)) K,
      Function.Surjective L.mulVecLin ∧
      ∀ j z, u j ⬝ᵥ z = 0 → L *ᵥ z = 0 → z = 0 := by
  obtain ⟨w, hw, havoid⟩ := exists_common_vector u hu
  refine ⟨LinearMap.toMatrix' (reduction w), ?_, ?_⟩
  · simpa only [← Matrix.toLin'_apply', Matrix.toLin'_toMatrix'] using reduction_surjective w
  · intro j z hz hL
    apply reduction_injective_on_annihilator hw (havoid j) hz
    change (Matrix.toLin' (LinearMap.toMatrix' (reduction w))) z = 0 at hL
    simpa using hL

/-- The same statement indexed by a positive matrix size `m`. -/
theorem exists_reduction_on_hyperplanes_of_pos
    (m : ℕ) (hm : 0 < m) (u : J → Fin m → K) (hu : ∀ j, u j ≠ 0) :
    ∃ L : Matrix (Fin (m - 1)) (Fin m) K,
      Function.Surjective L.mulVecLin ∧
      ∀ j z, u j ⬝ᵥ z = 0 → L *ᵥ z = 0 → z = 0 := by
  cases m with
  | zero => exact (Nat.not_lt_zero _ hm).elim
  | succ k => simpa using exists_reduction_on_hyperplanes u hu

end
end Sheshadri.GenericReduction
