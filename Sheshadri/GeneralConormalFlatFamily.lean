import Sheshadri.SaturatedFlatFamily
import Mathlib.RingTheory.LocalProperties.Reduced
import Mathlib.RingTheory.Localization.Algebra
import Mathlib.RingTheory.Localization.Away.Basic
import Mathlib.RingTheory.Adjoin.Basic
import Mathlib.RingTheory.FiniteType

/-!
# Flat standard conormal charts over an arbitrary PID

This construction does not replace a selected algebraic curve by an affine
line.  The base can be any PID, in particular the DVR at a smooth point of
the selected curve.  Starting with the reduced horizontal coordinate ring,
we localize at one primal coordinate times one dual coordinate and take the
subalgebra generated by the standard projective coordinate ratios.

The rings, ratios, and maps are explicit.  Flatness follows from proved
torsion-freeness of localizations and subalgebras, not an assumed dominance
or flatness certificate.  Identifying these ratio rings with the affine
charts of a globally glued relative biprojective scheme is separate.
-/

noncomputable section
namespace Sheshadri.GeneralConormalFlatFamily

section Localization

variable {R Q L : Type*} [CommRing R] [CommRing Q] [CommRing L]
variable [Algebra R Q] [Algebra R L] [Algebra Q L] [IsScalarTower R Q L]

/-- Localization preserves torsion-freeness over an external base, even
when the total-space ring has several components or the localization is zero. -/
theorem localization_torsionfree (M : Submonoid Q) [IsLocalization M L]
    [NoZeroSMulDivisors R Q] : NoZeroSMulDivisors R L := by
  constructor
  intro r z hrz
  by_cases hr : r = 0
  · exact Or.inl hr
  · right
    obtain ⟨s, m, rfl⟩ := IsLocalization.mk'_surjective M z
    rw [← algebraMap_smul (A := Q), IsLocalization.smul_mk'] at hrz
    obtain ⟨n, hn⟩ := (IsLocalization.mk'_eq_zero_iff (S := L) _ _).mp hrz
    apply (IsLocalization.mk'_eq_zero_iff (S := L) _ _).mpr
    refine ⟨n, ?_⟩
    have h : r • ((n : Q) * s) = 0 := by
      simpa only [Algebra.smul_def, mul_left_comm] using hn
    exact (smul_eq_zero.mp h).resolve_left hr

/-- Every actual base subalgebra of a torsion-free algebra is torsion-free. -/
theorem subalgebra_torsionfree [NoZeroSMulDivisors R Q] (B : Subalgebra R Q) :
    NoZeroSMulDivisors R B :=
  Subtype.val_injective.noZeroSMulDivisors B.val (map_zero _)
    (fun r x => B.val.toLinearMap.map_smul r x)

/-- In particular every such subalgebra is flat over a PID. -/
theorem subalgebra_flat [IsDomain R] [IsPrincipalIdealRing R]
    [NoZeroSMulDivisors R Q] (B : Subalgebra R Q) : Module.Flat R B := by
  letI := subalgebra_torsionfree B
  exact ConormalFlatness.flat_of_torsionfree_pid R B

end Localization

section Charts

variable (R : Type*) [CommRing R]
variable {Q X Y : Type*} [CommRing Q] [Algebra R Q]
variable (x : X → Q) (y : Y → Q) (i : X) (j : Y)

abbrev chartDenominator : Q := x i * y j

/-- The actual principal-open coordinate ring of the homogeneous cone. -/
abbrev OpenChartRing := Localization.Away (chartDenominator x y i j)

/-- The coordinate `x k / x i`, represented with the common chart denominator. -/
def leftRatio (k : X) : OpenChartRing x y i j :=
  algebraMap Q (OpenChartRing x y i j) (x k * y j) *
    IsLocalization.Away.invSelf (chartDenominator x y i j)

/-- The coordinate `y k / y j`. -/
def rightRatio (k : Y) : OpenChartRing x y i j :=
  algebraMap Q (OpenChartRing x y i j) (x i * y k) *
    IsLocalization.Away.invSelf (chartDenominator x y i j)

@[simp] theorem leftRatio_self : leftRatio x y i j i = 1 :=
  IsLocalization.Away.mul_invSelf _

@[simp] theorem rightRatio_self : rightRatio x y i j j = 1 :=
  IsLocalization.Away.mul_invSelf _

/-- The standard biprojective chart coordinate subalgebra, generated by
the two families of normalized homogeneous coordinates. -/
def ratioChart : Subalgebra R (OpenChartRing x y i j) :=
  Algebra.adjoin R (Set.range (leftRatio x y i j) ∪ Set.range (rightRatio x y i j))

theorem leftRatio_mem_chart (k : X) : leftRatio x y i j k ∈ ratioChart R x y i j :=
  Algebra.subset_adjoin (Or.inl ⟨k, rfl⟩)

theorem rightRatio_mem_chart (k : Y) : rightRatio x y i j k ∈ ratioChart R x y i j :=
  Algebra.subset_adjoin (Or.inr ⟨k, rfl⟩)

/-- Finitely many projective coordinates give a finitely generated chart
algebra over the actual base ring. -/
instance ratioChart_finiteType [Finite X] [Finite Y] :
    Algebra.FiniteType R (ratioChart R x y i j) := by
  apply (Subalgebra.fg_iff_finiteType _).mp
  apply Subalgebra.fg_def.mpr
  exact ⟨_, (Set.finite_range _).union (Set.finite_range _), rfl⟩

instance ratioChart_noetherian [Finite X] [Finite Y] [IsNoetherianRing R] :
    IsNoetherianRing (ratioChart R x y i j) :=
  Algebra.FiniteType.isNoetherianRing R _

instance openChart_torsionfree [NoZeroSMulDivisors R Q] :
    NoZeroSMulDivisors R (OpenChartRing x y i j) :=
  localization_torsionfree (Submonoid.powers (chartDenominator x y i j))

theorem ratioChart_torsionfree [NoZeroSMulDivisors R Q] :
    NoZeroSMulDivisors R (ratioChart R x y i j) :=
  subalgebra_torsionfree _

instance openChart_reduced [IsReduced Q] : IsReduced (OpenChartRing x y i j) :=
  inferInstanceAs (IsReduced (Localization (Submonoid.powers (chartDenominator x y i j))))

theorem ratioChart_reduced [IsReduced Q] : IsReduced (ratioChart R x y i j) :=
  isReduced_of_injective (ratioChart R x y i j).val Subtype.val_injective

variable [IsDomain R] [IsPrincipalIdealRing R]

theorem openChart_flat [NoZeroSMulDivisors R Q] :
    Module.Flat R (OpenChartRing x y i j) :=
  ConormalFlatness.flat_of_torsionfree_pid R _

theorem ratioChart_flat [NoZeroSMulDivisors R Q] :
    Module.Flat R (ratioChart R x y i j) :=
  subalgebra_flat _

end Charts

section HorizontalCharts

open SaturatedFlatFamily

variable (R K : Type*) [CommRing R] [Field K] [Algebra R K]
variable [IsDomain R] [IsFractionRing R K] [IsPrincipalIdealRing R]
variable {X Y : Type*} (I : Ideal (MvPolynomial (X ⊕ Y) K))

def horizontalLeftCoordinate (i : X) : HorizontalRing R K I :=
  Ideal.Quotient.mk (horizontalIdeal R K I) (MvPolynomial.X (Sum.inl i))

def horizontalRightCoordinate (j : Y) : HorizontalRing R K I :=
  Ideal.Quotient.mk (horizontalIdeal R K I) (MvPolynomial.X (Sum.inr j))

/-- A concrete standard chart of the reduced horizontal coordinate ring. -/
abbrev HorizontalRatioChart (i : X) (j : Y) :=
  ratioChart R (horizontalLeftCoordinate R K I) (horizontalRightCoordinate R K I) i j

/-- Flatness for every displayed chart over any PID/DVR base, without
flatness or dominance hypotheses on the input generic ideal. -/
theorem horizontalRatioChart_flat (i : X) (j : Y) :
    Module.Flat R (HorizontalRatioChart R K I i j) :=
  ratioChart_flat R _ _ i j

theorem horizontalRatioChart_reduced (i : X) (j : Y) :
    IsReduced (HorizontalRatioChart R K I i j) :=
  ratioChart_reduced R _ _ i j

/-- The corresponding principal-open ring of the actual reduced generic
coordinate algebra.  Its base scalars already lie in the fraction field. -/
abbrev GenericOpenChart (i : X) (j : Y) :=
  Localization.Away
    (genericEmbedding R K I
      (chartDenominator (horizontalLeftCoordinate R K I)
        (horizontalRightCoordinate R K I) i j))

/-- The displayed ratio chart embeds in the actual generic open cone. -/
def horizontalRatioGenericMap (i : X) (j : Y) :
    HorizontalRatioChart R K I i j →ₐ[R] GenericOpenChart R K I i j :=
  (IsLocalization.Away.mapₐ
    (OpenChartRing (horizontalLeftCoordinate R K I) (horizontalRightCoordinate R K I) i j)
    (GenericOpenChart R K I i j) (genericEmbedding R K I)
    (chartDenominator (horizontalLeftCoordinate R K I)
      (horizontalRightCoordinate R K I) i j)).comp (HorizontalRatioChart R K I i j).val

set_option maxHeartbeats 800000 in
theorem horizontalRatioGenericMap_injective (i : X) (j : Y) :
    Function.Injective (horizontalRatioGenericMap R K I i j) :=
  (IsLocalization.Away.mapₐ_injective_of_injective
    (chartDenominator (horizontalLeftCoordinate R K I)
      (horizontalRightCoordinate R K I) i j)
    (genericEmbedding_injective R K I)).comp Subtype.val_injective

/-- The image of the genuine generic open cone is dense in the actual
ratio-chart spectrum. Thus no extra vertical component was inserted. -/
theorem horizontalRatioGenericMap_dense (i : X) (j : Y) :
    DenseRange (PrimeSpectrum.comap (horizontalRatioGenericMap R K I i j).toRingHom) := by
  rw [PrimeSpectrum.denseRange_comap_iff_ker_le_nilRadical]
  have hker : RingHom.ker (horizontalRatioGenericMap R K I i j).toRingHom = ⊥ :=
    (RingHom.injective_iff_ker_eq_bot (horizontalRatioGenericMap R K I i j).toRingHom).mp
      (horizontalRatioGenericMap_injective R K I i j)
  rw [hker]
  exact bot_le

/-- Every minimal component of the ratio chart has a generic point coming
from the generic open cone; this is derived, not assumed dominance. -/
theorem horizontalRatioChart_component_lifts (i : X) (j : Y)
    (p : Ideal (HorizontalRatioChart R K I i j))
    (hp : p ∈ minimalPrimes (HorizontalRatioChart R K I i j)) :
    ⟨p, hp.1.1⟩ ∈ Set.range
      (PrimeSpectrum.comap (horizontalRatioGenericMap R K I i j).toRingHom) :=
  (PrimeSpectrum.denseRange_comap_iff_minimalPrimes _).mp
    (horizontalRatioGenericMap_dense R K I i j) p hp

end HorizontalCharts

section Scheme

universe u
variable (R K : Type u) [CommRing R] [Field K] [Algebra R K]
variable [IsDomain R] [IsFractionRing R K] [IsPrincipalIdealRing R]
variable {X Y : Type u} (I : Ideal (MvPolynomial (X ⊕ Y) K))

/-- Each standard ratio chart has an actual flat structure morphism. -/
theorem horizontalRatioChart_spec_flat (i : X) (j : Y) :
    AlgebraicGeometry.Flat
      (AlgebraicGeometry.Spec.map
        (CommRingCat.ofHom (algebraMap R (HorizontalRatioChart R K I i j)))) := by
  rw [AlgebraicGeometry.HasRingHomProperty.Spec_iff (P := @AlgebraicGeometry.Flat)]
  exact flat_algebraMap_iff.mpr (horizontalRatioChart_flat R K I i j)

end Scheme

end Sheshadri.GeneralConormalFlatFamily
